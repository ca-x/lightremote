[Unit]
Description=LightRemote resident host (explicit unattended policy)
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
EnvironmentFile=%h/.config/lightremote-host/host.env
ExecStart=/bin/bash "%h/.local/lib/lightremote-host/run-host.sh"
WorkingDirectory=%h
UMask=0077
Restart=always
RestartSec=10s
RestartPreventExitStatus=64
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=30s
StandardInput=null
StandardOutput=null
StandardError=journal
# Keep status only; CLI stdout/stderr are discarded by run-host.sh.
LimitCORE=0

[Install]
WantedBy=default.target
