[Unit]
Description=LightRemote headless unattended host daemon
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=lightremote
Group=lightremote
UMask=0077
StateDirectory=lightremote-daemon
StateDirectoryMode=0700
ExecStart=/usr/local/bin/lightremote-daemon --config /etc/lightremote-daemon/daemon.json
Restart=on-failure
# The daemon exits 75 after an idle update. Keep it a failure so it restarts.
RestartForceExitStatus=75
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=45
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/lightremote-daemon
# The stock unit deliberately disables desktop access and self-modification.
# Add narrowly scoped ReadWritePaths for an explicitly configured writable share.
StandardOutput=null
StandardError=journal

[Install]
WantedBy=multi-user.target
